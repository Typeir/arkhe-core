{
  "name": "@arkhe/core",
  "version": "0.2.0",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fx": {
      "types": "./dist/fx/index.d.ts",
      "default": "./dist/fx/index.js"
    },
    "./arkhe.css": "./dist/arkhe.css",
    "./styles/*": "./styles/*"
  },
  "files": [
    "dist",
    "styles"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && sass --no-source-map styles/arkhe.scss dist/arkhe.css",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "sass": "1.107.0",
    "typescript": "6.0.3"
  }
}
