{
  "name": "@arkhe/core",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./arkhe.css": "./dist/arkhe.css",
    "./styles/*": "./styles/*"
  },
  "files": [
    "dist",
    "styles"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && sass --no-source-map styles/arkhe.scss dist/arkhe.css",
    "typecheck": "tsc -p tsconfig.json"
  }
}
